{
  "manifest_version": 3,
  "name": "ChatGPT Style for Gemini",
  "version": "1.0.0",
  "description": "Restyles Gemini with ChatGPT's calm typography, reading rhythm, code blocks, and light/dark surface polish—while keeping Gemini's features and icons intact.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Style for Gemini",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "styles/chatgpt-theme.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
